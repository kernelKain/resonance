# TrueForge local mode (SQLite). Keep this container off the public internet.
FROM node:22-bookworm-slim
WORKDIR /data

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g @truefoundry/trueforge@latest

ENV NODE_ENV=production
ENV PORT=8790
ENV SQLITE_PATH=/data/trueforge.sqlite

EXPOSE 8790
CMD ["npx", "--yes", "@truefoundry/trueforge"]
