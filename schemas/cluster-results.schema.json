{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resonance cluster_results payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "algorithm",
    "feature_order",
    "num_clusters",
    "silhouette_score",
    "k_candidates",
    "random_state",
    "total_reviews",
    "clusters",
    "assignments"
  ],
  "properties": {
    "type": { "const": "cluster_results" },
    "algorithm": { "const": "kmeans" },
    "feature_order": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "type": "string" }
    },
    "num_clusters": { "type": "integer", "minimum": 1 },
    "silhouette_score": { "type": "number" },
    "k_candidates": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "random_state": { "type": "integer" },
    "total_reviews": { "type": "integer", "minimum": 1 },
    "clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "size",
          "centroid",
          "member_ids",
          "representative_review_ids"
        ],
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "size": { "type": "integer", "minimum": 1 },
          "centroid": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "joy",
              "trust",
              "fear",
              "surprise",
              "sadness",
              "disgust",
              "anger",
              "anticipation"
            ],
            "properties": {
              "joy": { "type": "number", "minimum": 0, "maximum": 1 },
              "trust": { "type": "number", "minimum": 0, "maximum": 1 },
              "fear": { "type": "number", "minimum": 0, "maximum": 1 },
              "surprise": { "type": "number", "minimum": 0, "maximum": 1 },
              "sadness": { "type": "number", "minimum": 0, "maximum": 1 },
              "disgust": { "type": "number", "minimum": 0, "maximum": 1 },
              "anger": { "type": "number", "minimum": 0, "maximum": 1 },
              "anticipation": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "member_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer" }
          },
          "representative_review_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": { "type": "integer" }
          }
        }
      }
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cluster_id"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "cluster_id": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}