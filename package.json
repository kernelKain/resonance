{
  "name": "resonance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 43123",
    "mcp": "node mcp/filesystem/server.mjs",
    "resonance": "concurrently -k -n web,mcp -c cyan,magenta \"npm run dev\" \"npm run mcp\"",
    "harness": "npx --yes @truefoundry/trueforge@latest",
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 43123",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:all",
    "test:all": "npm run test:parse && npm run test:plutchik && npm run test:insights && npm run test:hitl && npm run test:turn && npm run test:hitl-parse && npm run test:hero && npm run test:tooltip && npm run test:model-router && npm run test:pdf",
    "test:parse": "npx --yes tsx scripts/validate-stream-parse.ts",
    "test:plutchik": "npx --yes tsx scripts/validate-plutchik-averages.ts",
    "test:insights": "npx --yes tsx scripts/validate-insight-views.ts",
    "test:hitl": "node scripts/validate-hitl-protocol.mjs",
    "test:turn": "npx --yes tsx scripts/validate-trueforge-turn.ts",
    "test:hitl-parse": "npx --yes tsx scripts/validate-hitl-stream-parse.ts",
    "test:hero": "npx --yes tsx scripts/validate-hero-csv.ts",
    "test:tooltip": "npx --yes tsx scripts/validate-tooltip.tsx",
    "test:model-router": "npx --yes tsx scripts/validate-model-router.ts",
    "test:pdf": "npx --yes tsx scripts/validate-pdf.tsx"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-pdf/renderer": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "express": "^5.2.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "2.15.4",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
