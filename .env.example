OPENROUTER_API_KEY=your_actual_key_here

# Daytona API key for the TrueForge sandbox 
# Create one at https://app.daytona.io (API Keys). Never commit the real key.
DAYTONA_API_KEY=

# Optional overrides
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
TRUEFORGE_AGENT_NAME=resonance
TRUEFORGE_MODEL=openrouter/minimax-minimax-m-3-free
TRUEFORGE_FALLBACK_AGENT_NAME=resonance-deepseek
TRUEFORGE_FALLBACK_MODEL=openrouter/deepseek-deepseek-v4-flash-0731
# Wait before a new analysis probes MiniMax after quota/rate-limit failure.
MODEL_COOLDOWN_MS=300000
UPLOAD_TTL_MS=86400000
MCP_URL=http://127.0.0.1:8792/mcp
MCP_BASE_URL=http://127.0.0.1:8792
MCP_HOST=127.0.0.1
MCP_PORT=8792
MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# Docker Compose / Oracle VM (see deploy/README.md). Leave unset for local npm.
# MCP_HOST=0.0.0.0
# MCP_ALLOWED_HOSTS=mcp,mcp:8792,localhost,127.0.0.1
CLOUDFLARE_TUNNEL_TOKEN=

# Sandbox exec timeout. Catalog default is 60000ms — too short for pip + sklearn.
TRUEFORGE_SANDBOX_EXEC_TIMEOUT_MS=300000
