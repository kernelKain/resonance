[Unit]
Description=Resonance filesystem MCP
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/resonance
EnvironmentFile=/opt/resonance/.env
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=8792
ExecStart=/usr/bin/node mcp/filesystem/server.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
